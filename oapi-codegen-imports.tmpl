{{/*
Overrides oapi-codegen's built-in imports.tmpl. The only change is dropping its
"Package {{.PackageName}} provides primitives to interact with the openapi HTTP
API." doc comment, which would otherwise be concatenated onto the package
documentation already written in buildkite.go. Unused imports are stripped by
oapi-codegen's goimports pass.
*/ -}}
// Code generated by {{.ModuleName}} version {{.Version}} DO NOT EDIT.
package {{.PackageName}}

import (
	"bytes"
	"compress/flate"
	"context"
	"encoding/base64"
	"encoding/json"
	"encoding/xml"
	"errors"
	"fmt"
	"go.yaml.in/yaml/v3"
	"io"
	"os"
	"mime"
	"mime/multipart"
	"net/http"
	"net/url"
	"path"
	"strings"
	"time"

	"github.com/oapi-codegen/runtime"
	"github.com/oapi-codegen/nullable"
	openapi_types "github.com/oapi-codegen/runtime/types"
	"github.com/getkin/kin-openapi/openapi3"
	{{- range .RouterImports}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Package}}"
	{{- end}}
	{{- range .ExternalImports}}
	{{ . }}
	{{- end}}
	{{- range .AdditionalImports}}
	{{.Alias}} "{{.Package}}"
	{{- end}}
)
